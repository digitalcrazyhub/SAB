# Production configuration. Copy to .env and keep it outside version control.
APP_ORIGIN=https://www.example.com
APP_TIMEZONE=Asia/Kolkata

DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sri Amma Industrial Developers Pvt. Ltd.
BUSINESS_EMAIL=
BUSINESS_PHONE=
WEBSITE_URL=https://www.example.com

RECAPTCHA_SITE_KEY=ADD_RECAPTCHA_SITE_KEY_HERE
RECAPTCHA_SECRET_KEY=ADD_RECAPTCHA_SECRET_KEY_HERE

GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=/home/USERNAME/private/google-service-account.json
GOOGLE_SHEET_RANGE=Enquiries!A:H

# 64-character random secret used to sign CSRF tokens and rate-limit hashes.
APP_SECRET=
