# ==============================================================================
# SRI AMMA BUILDER PVT LTD — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` in this directory or in the project root.
# NEVER commit the actual `.env` file containing live credentials to Git.
# ==============================================================================

# Application Environment
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/SAB
TIMEZONE=Asia/Kolkata

# MySQL Database Configuration (Local XAMPP / Production Hostinger MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=testmail_db
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# SMTP Email Credentials (Gmail App Password or Hostinger Business Mail)
# For Gmail: host=smtp.gmail.com, port=465, encryption=ssl, password=16-char-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=digitalcrazyhub2020@gmail.com
SMTP_PASSWORD=
SMTP_ENCRYPTION=ssl
MAIL_FROM=digitalcrazyhub2020@gmail.com
MAIL_FROM_NAME="Sri Amma Builder Pvt Ltd"
COMPANY_EMAIL=sudhakarvasudevanofficial@gmail.com
COMPANY_NAME="Sri Amma Builder Pvt Ltd Management"

# Google reCAPTCHA v3 (Set true in production after adding secret key)
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_EXPECTED_ACTION=contact_form

# Google Sheets Synchronization (Optional)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE="Leads!A:M"
GOOGLE_SERVICE_ACCOUNT_PATH=

# Rate Limiting (5 requests per 10 minutes per IP)
RATE_LIMIT_MAX_HITS=5
RATE_LIMIT_WINDOW_SECONDS=600
