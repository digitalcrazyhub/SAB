# ==============================================================================
# SRI AMMA BUILDER PVT LTD — BACKEND HTTP ACCESS CONTROL
# Protects private configuration, credentials, logs, and internal modules.
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Deny access to sensitive files and extensions
<FilesMatch "(^\.|\.env(\..*)?$|composer\.(json|lock)$|README\.md|\.(sql|log|json|md|bak|backup|old|save|tmp|swp|zip|tar|gz))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow direct access to the public API and wrapper endpoints
    RewriteRule ^api/contact\.php$ - [L]
    RewriteRule ^contact-submit\.php$ - [L]

    # Forbid direct public web access to all internal backend modules and data
    RewriteRule ^(?:config|database|security|mail|google|services|queue|logs|vendor)/ - [F,L]
</IfModule>

# Security headers (use 'set' to avoid header duplication with PHP)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
