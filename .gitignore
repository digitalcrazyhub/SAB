# Environment variables & private credentials
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
backend/config/private/
*.pem
*.key

# Credentials & sensitive service account keys
backend/credentials/*
!backend/credentials/.htaccess
!backend/credentials/.gitkeep

# Review trash (Non-destructive cleanup)
/_review_trash/
_review_trash/

# Composer dependencies
/vendor/
/backend/vendor/
composer.phar

# Application logs & cache
*.log
/backend/logs/*
!/backend/logs/.gitkeep
!backend/logs/.htaccess
/logs/

# Temporary, backup & OS files
.DS_Store
Thumbs.db
*.bak
*.tmp
*.swp
*~
*.zip

# IDE & Editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
node_modules/
